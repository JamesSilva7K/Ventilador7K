# ============================================================
#  .env.example — Copie para .env e preencha os valores reais
#  NUNCA commite o .env real no repositório!
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
TG_BOT_TOKEN=SEU_TOKEN_AQUI
TG_OWNER_ID=SEU_TELEGRAM_ID_AQUI

# ── Chave mestra de criptografia AES-256-GCM ─────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# ── Chave PIX ─────────────────────────────────────────────────
PIX_KEY=SUA_CHAVE_PIX_AQUI
PIX_RECEIVER_NAME=MERCADO PAGO
PIX_CITY=SAO PAULO

# ── API de Pagamento (UniãoPay) ───────────────────────────────
PAYMENT_API_KEY=up_live_XXXXXXXX

# ── Servidor (Node.js) ───────────────────────────────────────
PORT=3030
STATUS_SECRET=SENHA_PARA_ENDPOINT_STATUS

# ── Segurança ─────────────────────────────────────────────────
ALLOWED_ORIGIN=https://seusite.com

# ── WhatsApp — Botão de contato rápido no Telegram ────────────
# Mensagem pré-preenchida quando admin clica em "Contatar via WhatsApp"
# Use [Nome] para substituição automática pelo nome do lead (se disponível)
WA_PREFILL_MSG=Olá! Vi que você iniciou um pedido do Ventilador Mondial 40cm. Posso te ajudar a finalizar?

# ── GeoIP (ip-api.com — grátis, sem API key, até 45 req/min) ──
# Exibe cidade/estado/ISP do lead nas mensagens do Telegram
GEOIP_ENABLED=true
